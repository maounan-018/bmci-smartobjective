# ObjectifSMART-AI — Modèle de configuration
# Copier ce fichier en ".env" puis renseigner les valeurs réelles.
# NE JAMAIS committer le fichier .env (il est dans .gitignore).

# ─── Sécurité ────────────────────────────────────────────────────────────────
# Clé secrète de l'application (générer : python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=CHANGER_PAR_UNE_CLE_ALEATOIRE_DE_64_CARACTERES

# Durée de validité d'une session, en heures
SESSION_DURATION_HOURS=24

# Nombre d'itérations PBKDF2 pour le hachage des mots de passe
PBKDF2_ITERATIONS=200000

# Limitation des tentatives de connexion (anti brute-force)
MAX_LOGIN_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# Limite globale de la taille des requetes (Mo) — protection DoS upload.
# Toute requete dont Content-Length depasse cette valeur est rejetee en 413.
MAX_REQUEST_SIZE_MB=20

# ─── Base de données ──────────────────────────────────────────────────────────
DATABASE_PATH=objectifsmart.db

# ─── Serveur / CORS ───────────────────────────────────────────────────────────
# Origines autorisées (séparées par des virgules). En production : domaine réel.
# OBLIGATOIRE : le démarrage échoue si cette variable n'est pas définie.
# "*" est interdit (incompatible avec allow_credentials=True ⇒ CSRF cross-origin).
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ─── Intelligence Artificielle (Ollama) ───────────────────────────────────────
OLLAMA_URL=http://localhost:11434/api/generate
OLLAMA_MODEL=smart-qwen8

# ─── Comptes de démonstration (seed au 1er démarrage uniquement) ──────────────
# À changer impérativement hors développement.
SEED_MANAGER_PASSWORD=REDACTED_DEMO_PWD
SEED_HR_PASSWORD=REDACTED_DEMO_PWD
SEED_COLLAB_PASSWORD=REDACTED_DEMO_PWD

# ─── Future intégration IAM bancaire (laisser vide en développement) ──────────
# LDAP_SERVER_URL=ldap://ad.bmci.co.ma
# LDAP_BASE_DN=DC=bmci,DC=co,DC=ma
# SSO_CLIENT_ID=
# SSO_CLIENT_SECRET=
# SSO_DISCOVERY_URL=
