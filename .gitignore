# Dépendances
node_modules
__pycache__/
*.pyc

# Environnement
# backend/.env est COMMITTE volontairement (repo privé, config de dev SANS secret
# réel) → un seul env, identique en local et sur GitHub. On continue d'ignorer
# tout autre .env et les .env.local (réservés aux VRAIS secrets, jamais committés).
.env
!backend/.env
.env.local

# Base de données locale
*.db

# Build frontend
dist/
.vite/

# Sorties des outils PDF (projet_en_pdf.py / pdf_en_projet.py)
_pdf_export/
_code_reconstruit/
