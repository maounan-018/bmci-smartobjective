# =============================================================================
# backend/.env - Configuration de l'application (VERSIONNEE volontairement).
#
# Un seul env, identique en local et sur GitHub : l'application demarre
# directement apres un clone, sans etape manuelle.
#
# /!\ NE JAMAIS y mettre de VRAI secret (cle API reelle, mot de passe de prod,
#     identifiants SSO). Ce fichier est dans le depot. Pour de vrais
#     secrets, utiliser un .env.local (ignore par git) ou les secrets GitHub
#     Actions. Ici : uniquement de la config de developpement local.
# =============================================================================

APP_NAME=ObjectifSMART-AI

# --- Logs ---
# Niveau de log : DEBUG | INFO | WARNING | ERROR. En prod : INFO (masque le DEBUG,
# donc aucune donnee RH/analyse dans les journaux). DEBUG = verbeux (dev).
LOG_LEVEL=INFO

# --- IA locale (Ollama) ---
# Modele dedie construit depuis le Modelfile (FROM qwen3:8b) et present localement.
OLLAMA_URL=http://localhost:11434/api/generate
OLLAMA_MODEL=smart-qwen8
# Modele du Coach IA conversationnel (chat). qwen3:8b = ton plus naturel que
# smart-qwen8 (regle pour l'analyse SMART en JSON). Les deux sont 100% locaux.
OLLAMA_CHAT_MODEL=qwen3:8b
# Nombre d'essais d'appel au modele (reessai si reponse vide {} ou non parsable).
AI_MAX_ATTEMPTS=2

# --- Base de donnees (SQLite locale) ---
DATABASE_PATH=objectifsmart.db

# --- Sessions / securite ---
SESSION_DURATION_HOURS=24
PBKDF2_ITERATIONS=200000
MAX_LOGIN_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
MAX_REQUEST_SIZE_MB=20

# --- Rate limiting des appels IA (anti-saturation d'Ollama) ---
# Au plus AI_RATE_LIMIT_MAX analyses par AI_RATE_LIMIT_WINDOW_SECONDS et par
# utilisateur (etat en base -> multi-worker). Au-dela : HTTP 429.
AI_RATE_LIMIT_MAX=10
AI_RATE_LIMIT_WINDOW_SECONDS=60

# --- CORS : origines autorisees (OBLIGATOIRE ; "*" interdit) ---
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:5173

# --- Comptes de demonstration (seed idempotent au demarrage) ---
# Crees automatiquement s'ils n'existent pas (cf. database/seed.py) :
#   manager@bmci.ma / hr@bmci.ma / collab@bmci.ma
# Mettre SEED_DEMO_ACCOUNTS=false en production. Mots de passe A CHANGER.
SEED_DEMO_ACCOUNTS=true
SEED_MANAGER_PASSWORD=REDACTED_DEMO_PWD
SEED_HR_PASSWORD=REDACTED_DEMO_PWD
SEED_COLLAB_PASSWORD=REDACTED_DEMO_PWD

# --- Environnement & durcissement ---
# development (defaut) | production. En production : la SIMULATION SSO est
# refusee, et il est recommande de couper la connexion locale (voir ci-dessous).
ENV=development

# --- Authentification : fournisseur d'identite ---
# local (defaut) = base SQLite. Le SSO SAML s'active des que SP + IdP sont configures.
AUTH_PROVIDER=local

# Connexion locale (email/mot de passe) : auto (defaut) | true | false.
# "auto" = activee seulement si le SSO reel n'est pas configure. En SSO reel,
# elle est coupee automatiquement (anti porte derobee via comptes seedes).
LOCAL_AUTH_ENABLED=auto

# Filtre d'autorisation SSO (optionnel) : liste de groupes autorises (virgules).
# Vide = tout employe authentifie est accepte. Ex : GRP_RH,GRP_MANAGERS,GRP_COLLABORATEURS
# SAML_ALLOWED_GROUPS=

# --- SIMULATION SSO (DEV UNIQUEMENT) ---
# Mettre a true pour TESTER le flux SSO sans Entra ID ni python3-saml :
# le bouton "SSO BMCI" mene a une page de choix de persona (RH/Manager/Collab).
# /!\ NE JAMAIS mettre true en production (bypass d'authentification).
# Ignore automatiquement des que le SSO reel (SP+IdP) est configure.
SAML_SIMULATION=false

# --- SSO SAML 2.0 (ADFS / Microsoft Entra ID) ---
# Le SSO s'active automatiquement des que SP + IdP sont renseignes.
# Installer la dependance : pip install -r requirements-saml.txt
# Les VRAIS secrets (certificats, cle privee) -> backend/.env.local (jamais ici).
#
# SP = cette application (a declarer aupres de la DSI via /api/auth/saml/metadata)
# SAML_SP_ENTITY_ID=https://example.com/api/auth/saml/metadata
# SAML_SP_ACS_URL=https://example.com/api/auth/saml/acs
# SAML_SP_SLS_URL=https://example.com/api/auth/saml/logout
# SAML_SP_X509_CERT=
# SAML_SP_PRIVATE_KEY=
#
# IdP = l'annuaire de la banque (valeurs fournies par la DSI)
# SAML_IDP_ENTITY_ID=
# SAML_IDP_SSO_URL=
# SAML_IDP_SLO_URL=
# SAML_IDP_X509_CERT=
#
# Apres login SSO, le navigateur est renvoye vers cette base d'URL frontend
# SAML_FRONTEND_REDIRECT=http://localhost:3000
#
# Mapping des claims (valeurs Microsoft par defaut ; laisser vide = fallback auto)
# SAML_ATTR_EMAIL=
# SAML_ATTR_NAME=
# SAML_ATTR_GROUPS=http://schemas.microsoft.com/ws/2008/06/identity/claims/groups
# SAML_DEFAULT_ROLE=COLLAB
