# =============================================================================
# backend/.env - Configuration de l'application (VERSIONNEE volontairement).
#
# Un seul env, identique en local et sur GitHub : l'application demarre
# directement apres un clone, sans etape manuelle.
#
# /!\ NE JAMAIS y mettre de VRAI secret (cle API reelle, mot de passe de prod,
#     identifiants LDAP/SSO). Ce fichier est dans le depot. Pour de vrais
#     secrets, utiliser un .env.local (ignore par git) ou les secrets GitHub
#     Actions. Ici : uniquement de la config de developpement local.
# =============================================================================

APP_NAME=ObjectifSMART-AI

# --- IA locale (Ollama) ---
# Modele actuel : qwen3:4b. Passage prevu a smart-qwen8 (cf. Modelfile) plus tard.
OLLAMA_URL=http://localhost:11434/api/generate
OLLAMA_MODEL=qwen3:4b

# --- Base de donnees (SQLite locale) ---
DATABASE_PATH=objectifsmart.db

# --- Sessions / securite ---
SESSION_DURATION_HOURS=24
PBKDF2_ITERATIONS=200000
MAX_LOGIN_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
MAX_REQUEST_SIZE_MB=20

# --- CORS : origines autorisees (OBLIGATOIRE ; "*" interdit) ---
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:5173

# --- Comptes de demonstration (seed idempotent au demarrage) ---
# Crees automatiquement s'ils n'existent pas (cf. database/seed.py) :
#   manager@bmci.ma / hr@bmci.ma / collab@bmci.ma
# Mettre SEED_DEMO_ACCOUNTS=false en production. Mots de passe A CHANGER.
SEED_DEMO_ACCOUNTS=true
SEED_MANAGER_PASSWORD=REDACTED_DEMO_PWD
SEED_HR_PASSWORD=REDACTED_DEMO_PWD
SEED_COLLAB_PASSWORD=REDACTED_DEMO_PWD

# --- Authentification : fournisseur d'identite ---
# local (defaut) | ldap | saml. Local = base SQLite.
AUTH_PROVIDER=local

# --- LDAP / Active Directory (optionnel, laisser commente en dev) ---
# LDAP_SERVER_URL=ldap://ad.bmci.co.ma
# LDAP_BASE_DN=DC=bmci,DC=co,DC=ma

# --- SSO SAML 2.0 (ADFS / Microsoft Entra ID) ---
# Le SSO s'active automatiquement des que SP + IdP sont renseignes.
# Installer la dependance : pip install -r requirements-saml.txt
# Les VRAIS secrets (certificats, cle privee) -> backend/.env.local (jamais ici).
#
# SP = cette application (a declarer aupres de la DSI via /api/auth/saml/metadata)
# SAML_SP_ENTITY_ID=https://example.com/api/auth/saml/metadata
# SAML_SP_ACS_URL=https://example.com/api/auth/saml/acs
# SAML_SP_SLS_URL=https://example.com/api/auth/saml/logout
# SAML_SP_X509_CERT=
# SAML_SP_PRIVATE_KEY=
#
# IdP = l'annuaire de la banque (valeurs fournies par la DSI)
# SAML_IDP_ENTITY_ID=
# SAML_IDP_SSO_URL=
# SAML_IDP_SLO_URL=
# SAML_IDP_X509_CERT=
#
# Apres login SSO, le navigateur est renvoye vers cette base d'URL frontend
# SAML_FRONTEND_REDIRECT=http://localhost:3000
#
# Mapping des claims (valeurs Microsoft par defaut ; laisser vide = fallback auto)
# SAML_ATTR_EMAIL=
# SAML_ATTR_NAME=
# SAML_ATTR_GROUPS=http://schemas.microsoft.com/ws/2008/06/identity/claims/groups
# SAML_DEFAULT_ROLE=COLLAB
